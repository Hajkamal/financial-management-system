# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Optional. Model used by the /api/gemini/analyze proxy (default: gemini-2.5-flash).
GEMINI_MODEL="gemini-2.5-flash"

# ENABLE_EXTERNAL_AI: Must be exactly "true" to forward aggregate financial context to Google.
# Off by default by design; see docs/security-phase-1.md.
ENABLE_EXTERNAL_AI="false"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SUPABASE_URL / SUPABASE_URL: The URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# VITE_SUPABASE_ANON_KEY / SUPABASE_ANON_KEY: The public anon key for your Supabase project
VITE_SUPABASE_ANON_KEY=
