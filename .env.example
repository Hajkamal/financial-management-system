# ---------------------------------------------------------------------------
# Financial Management System — environment template
# Copy to .env and fill in your own values. Never commit .env or real keys.
# ---------------------------------------------------------------------------

# --- Supabase (server) -----------------------------------------------------
# Project URL, e.g. https://xyzcompany.supabase.co
SUPABASE_URL=""

# Public anon key used for user-scoped Auth and RPC calls.
SUPABASE_ANON_KEY=""

# Secret/service key for admin operations. SERVER ONLY — never use a VITE_ prefix.
SUPABASE_SECRET_KEY=""

# --- Supabase (browser build) ---------------------------------------------
# These are injected into the client bundle and must be the same project.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# --- Application -----------------------------------------------------------
# Canonical URL of the deployment, e.g. https://example.com
APP_URL="http://localhost:3000"

# Comma-separated extra allowed origins (optional).
APP_ORIGINS=""

# Local server port (default: 3000).
PORT="3000"

# Set when running behind a trusted reverse proxy (e.g. "1" on Vercel).
TRUST_PROXY=""

# --- Safety gates ----------------------------------------------------------
# Must be exactly "true" to enable financial write routes. Keep off until
# Auth, profiles, RLS and a backup/restore drill have been verified.
FINANCIAL_WRITES_ENABLED="false"

# Must be exactly "true" before any prompt or financial context is sent to
# Google Gemini. Off by default by design.
ENABLE_EXTERNAL_AI="false"

# --- Backups ---------------------------------------------------------------
# Random 32-byte key, base64-encoded. SERVER ONLY.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep an independent copy: losing this key makes existing snapshots unreadable.
BACKUP_ENCRYPTION_KEY=""

# --- AI (optional) ---------------------------------------------------------
# Required only when ENABLE_EXTERNAL_AI="true".
GEMINI_API_KEY=""

# Optional model override. Default: gemini-3.8-flash
GEMINI_MODEL="gemini-3.8-flash"

# Development only: return provider error details to the client.
AI_DEBUG_ERRORS="false"

# --- Runtime ---------------------------------------------------------------
# "production" serves the built dist/ directory.
NODE_ENV="development"
